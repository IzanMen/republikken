---
import Icon from './Icon.astro';
import type { FAQItem } from '../data/config';
interface Props {
  items: FAQItem[];
  title?: string;
}
const { items, title = 'Preguntas frecuentes sobre espacios y reservas.' } = Astro.props;
---

<section class="faq-section section wrap">
  <div>
    <h2>{title}</h2>
    <p>
      Y si te queda alguna duda,
      <br />
      <a class="text-link" href="/contacto">
        hablamos directamente <Icon />
      </a>
    </p>
  </div>
  <div class="faq-list">
    {items.map((item) => (
      <details>
        <summary>
          {item.question}
          <Icon name="plus" />
        </summary>
        <div class="faq-answer">
          <p>{item.answer}</p>
        </div>
      </details>
    ))}
  </div>
</section>
