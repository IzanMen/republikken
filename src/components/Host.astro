---
import Icon from './Icon.astro';
import { site, whatsapp } from '../data/config';
---

<section class="host-section wrap">
  <div class="host-monogram" aria-hidden="true">
    F.<small>FRAN · TU ANFITRIÓN</small>
  </div>
  <div>
    <h2>Habla directamente con Fran, propietario de Republikken.</h2>
    <p>
      El propietario de Republikken está detrás de cada reserva. Desde la primera pregunta hasta el
      día que llegas.
    </p>
  </div>
  <div class="host-contact">
    <a href={`tel:${site.phone}`} data-track="phone_click">
      {site.phoneDisplay}
    </a>
    <a
      class="text-link"
      href={whatsapp()}
      target="_blank"
      rel="noopener noreferrer"
      data-track="whatsapp_click"
    >
      Escríbele por WhatsApp <Icon name="diagonal" />
    </a>
  </div>
</section>
