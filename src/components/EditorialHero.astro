---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  position?: string;
}

const { src, alt, caption, position = 'center' } = Astro.props;
---

<div class="editorial-hero">
  <div class="page-intro">
    <slot />
  </div>
  <figure class="editorial-hero-media">
    <Image
      src={src}
      alt={alt}
      width={760}
      height={520}
      widths={[420, 760, 1100]}
      sizes="(max-width: 700px) 100vw, 46vw"
      format="webp"
      quality={82}
      loading="eager"
      style={`object-position:${position}`}
    />
    {caption && <figcaption>{caption}</figcaption>}
  </figure>
</div>
