---
import Layout from '../layouts/Layout.astro';
import CTA from '../components/CTA.astro';
import FAQ from '../components/FAQ.astro';
import Icon from '../components/Icon.astro';
import { commonFAQ } from '../data/config';
const faqs = [commonFAQ[0], commonFAQ[2], commonFAQ[3], commonFAQ[4]];
const steps = [
  {
    title: 'Elige tu espacio.',
    text: 'Un despacho para recibir clientes, una sala para reunir a tu equipo o un lugar para entrenar. Encuentra el espacio que encaja con tu actividad.',
    detail:
      'En cada ficha tienes la tarifa base, el equipamiento y las capacidades conocidas. Para eventos con catering o varios espacios, pide una propuesta.',
    href: '/espacios',
    link: 'Conoce los espacios',
  },
  {
    title: 'Consulta y reserva.',
    text: 'Selecciona el espacio y accede al calendario de nuestra plataforma de reservas, Cobot. Revisa las horas, el importe total con IVA y las condiciones antes de confirmar.',
    detail:
      'Las fechas solo quedan confirmadas cuando completas la reserva en la plataforma. Si no aparece el recurso que necesitas, habla con Fran.',
    href: '/reservar',
    link: 'Consultar disponibilidad',
  },
  {
    title: 'Llega y céntrate en lo tuyo.',
    text: 'Acordamos contigo las instrucciones de acceso antes de tu visita. Limpieza, suministros y climatización están incluidos.',
    detail:
      'Respeta el horario reservado y deja el material recogido al terminar. Para cambios, cancelaciones o necesidades especiales, contacta con Fran antes de confirmar.',
    href: '/contacto',
    link: 'Habla con Fran',
  },
];
---

<Layout
  title="Cómo reservar un espacio en Maó | Republikken"
  description="Elige un espacio desde {{precio_despacho}} €/h + IVA, consulta las horas y reserva en Cobot. Sin permanencia. Descubre cómo funciona Republikken."
  faqs={faqs}
  breadcrumbs={[{ name: 'Cómo funciona', url: '/como-funciona' }]}
>
  <section class="wrap">
    <div class="page-intro">
      <h1>Cómo reservar un espacio por horas en Republikken.</h1>
      <p>
        Sin alquilar un local. Sin permanencia. Elige el tiempo que necesitas y dedica tu energía a
        lo que vienes a hacer.
      </p>
    </div>
    <div class="process-list">
      {steps.map((step, i) => (
        <article class="process-row">
          <span class="number">0{i + 1}</span>
          <div>
            <h2>{step.title}</h2>
            <p>{step.text}</p>
          </div>
          <div>
            <p>{step.detail}</p>
            <a href={step.href} class="text-link">
              {step.link}
              <Icon />
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
  <FAQ items={faqs} />
  <CTA />
</Layout>
