---
import Layout from '../layouts/Layout.astro';
import { legalPages } from '../data/legal';
import { site } from '../data/config';
export function getStaticPaths() {
  return legalPages.map((page) => ({ params: { legal: page.slug }, props: { page } }));
}
const { page } = Astro.props;
---

<Layout
  title={`${page.title} | Republikken Maó`}
  description={page.description}
  noindex={!site.legalVerified}
  breadcrumbs={[{ name: page.title, url: `/${page.slug}` }]}
>
  <article class="wrap">
    <div class="page-intro">
      <h1>{page.title}</h1>
    </div>
    {page.slug === 'cookies' && (
      <div class="prose">
        <button class="button" data-cookie-settings>
          Configurar cookies
        </button>
      </div>
    )}
  </article>
</Layout>
