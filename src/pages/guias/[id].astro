---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CTA from '../../components/CTA.astro';
import EditorialHero from '../../components/EditorialHero.astro';
import office from '../../assets/images/despacho-privado-mao.jpg';
import meeting from '../../assets/images/sala-reuniones-republikken-mao.webp';
import event from '../../assets/images/evento-profesional-republikken-mao-anonimizado.png';
export async function getStaticPaths() {
  const guides = await getCollection('guias');
  return guides.map((guide) => ({ params: { id: guide.id }, props: { guide } }));
}
const { guide } = Astro.props;
const { Content } = await render(guide);
const guideMedia = {
  'despacho-por-horas-o-local': {
    src: office,
    alt: 'Despacho privado por horas de Republikken en Maó',
  },
  'organizar-curso-formacion-mao': {
    src: meeting,
    alt: 'Sala de reuniones preparada para un curso o formación en Republikken Maó',
  },
  'presentacion-producto-mao': {
    src: event,
    alt: 'Presentación profesional ante público en Republikken Maó',
  },
};
const media = guideMedia[guide.id as keyof typeof guideMedia];
const schema = [
  {
    '@type': 'Article',
    headline: guide.data.title,
    description: guide.data.description,
    author: { '@type': 'Organization', name: 'Republikken Maó' },
    publisher: { '@id': `${Astro.site}#organization` },
    image: new URL(`/og/guias-${guide.id}.png`, Astro.site).href,
    mainEntityOfPage: new URL(`/guias/${guide.id}`, Astro.site).href,
    inLanguage: 'es',
  },
];
---

<Layout
  title={guide.data.title}
  description={guide.data.description}
  schema={schema}
  breadcrumbs={[
    { name: 'Ideas y guías', url: '/guias' },
    { name: guide.data.title, url: `/guias/${guide.id}` },
  ]}
>
  <article class="wrap">
    <EditorialHero src={media.src} alt={media.alt} caption={`${guide.data.readingTime} de lectura`}>
      <h1 style="font-family:var(--font);font-weight:400;letter-spacing:-1.5px">
        {guide.data.title}
      </h1>
      <p>
        {guide.data.category} · {guide.data.readingTime}
      </p>
    </EditorialHero>
    <div class="prose">
      <Content />
    </div>
  </article>
  <CTA href={guide.data.cta} label={guide.data.ctaLabel} />
</Layout>
